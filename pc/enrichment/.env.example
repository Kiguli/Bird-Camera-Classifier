# Copy to .env and fill in. The .env file is gitignored - never commit real
# credentials. On Ubuntu, docker compose reads this automatically.

# --- Frigate (reached over the compose network by service name) ---
FRIGATE_URL=http://frigate:5000

# --- MQTT broker (the mosquitto service) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=frigate/events

# --- Which Frigate object labels trigger enrichment ---
# Comma-separated. "bird" is the main one; add cat/dog/squirrel-ish later.
TARGET_LABELS=bird

# --- Models (weights auto-download on first run into the mounted caches) ---
MD_VERSION=MDV6-yolov9-c          # compact MegaDetector v6, best for CPU
MD_CONF_THRES=0.2
BIOCLIP_MODEL=hf-hub:imageomics/bioclip-2
TOPK=3
CLASSIFY_FULL_FRAME_ON_NO_ANIMAL=true
# TORCH_NUM_THREADS=4             # optional cap for a shared box

# --- Storage (inside the container; mapped to a volume) ---
DB_PATH=/data/detections.sqlite
WORK_DIR=/data/media

# --- Classification thresholds ---
# Minimum BioCLIP confidence (0-1) to treat a species call as trustworthy.
# Below this we still record + notify, but flag the label as uncertain.
MIN_SPECIES_CONFIDENCE=0.30
# Minimum Frigate object score to bother enriching at all.
MIN_EVENT_SCORE=0.60

# --- Email notification ---
# DRY RUN: when true (default), emails are written to WORK_DIR as .eml files and
# logged, NOT sent. Set to false only once SMTP is configured and you have
# confirmed the recipient list.
MAIL_DRY_RUN=true

# Recipients, comma-separated. Put REAL addresses only in .env (gitignored),
# never here. Add more by comma-separating:
#   MAIL_TO=?????@?????,?????@?????
MAIL_TO=?????@?????
MAIL_FROM=Field Station <?????@?????>

# SMTP server. For Gmail use smtp.gmail.com:587 with an App Password (a 16-char
# code from Google Account > Security > App passwords - NOT your login password).
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=?????@?????
SMTP_PASSWORD=?????

# Attach the event clip (mp4) if it is under this size; otherwise attach only the
# snapshot image and note the clip location.
ATTACH_CLIP=true
MAX_ATTACH_MB=15

# Don't email the same event twice, and rate-limit bursts (seconds between mails
# for the same species; 0 = no limit).
PER_SPECIES_COOLDOWN=0

# Retry a failed email up to this many times (the maintenance sweep handles it).
EMAIL_MAX_RETRIES=5

# Runtime knobs (safe defaults; override only if needed).
WORK_QUEUE_MAXSIZE=100
MAINTENANCE_INTERVAL=300     # seconds between email-retry + media-prune sweeps
MEDIA_KEEP=500              # approx event media-sets to retain on disk
